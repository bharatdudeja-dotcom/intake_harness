# Local dev defaults to SQLite. Cloud Run uses Cloud SQL Postgres 16.
AM_DATABASE_URL=sqlite:///./agent_manager.db
# AM_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/agent_manager

AM_BASE_URL=http://127.0.0.1:8080
# Secret Manager in a deployed environment. Never commit a real one.
AM_JWT_SIGNING_KEY=dev-only-not-a-secret

# D9: Workfront goes through the in-house MCP estate (chaunceyplum/mcp).
# Paste the McpEndpointUrl SAM output — the same value the harness uses as
# MCP_ENDPOINT_URL. A trailing /mcp is stripped automatically.
AM_MCP_ENDPOINT_URL=
AM_WORKFRONT_INSTANCE=taplondonptrsd.my.workfront.com

# Every Workfront write is confirmed by a human before it executes.
AM_REQUIRE_HUMAN_CONFIRM_ON_WRITE=true
