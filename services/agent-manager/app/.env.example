# Adobe I/O Runtime MCP Server - Environment Variables
# Copy this file to .env and fill in your values

# Logging
LOG_LEVEL=

# --- Dual auth (Increment 2/3, D19/D21/D24) ---
# Authorization: Bearer <token> -> validated against the OIDC provider below (per-user identity)
# x-api-key: <key>              -> validated against SERVICE_API_KEY (headless agents)
# Neither/invalid                -> 401 with WWW-Authenticate pointing at the PRM document

# Temporary ChatGPT bring-up mode:
#   blank/default -> OAuth + x-api-key dual auth
#   none          -> no auth; unauthenticated MCP POSTs are allowed and tools/list
#                   does not advertise OAuth security schemes
MCP_AUTH_MODE=

# --- Pluggable auth provider (Increment 19, D66) ---
# Selects the validation strategy + the authorization server the PRM advertises:
#   auth0           -> JWKS audience-bound JWT verification
#   adobe-ims       -> userinfo-endpoint validation (fills in IMS issuer/discovery defaults)
#   microsoft-entra -> JWKS (config scaffold only this pass, not live-wired)
# Blank = derive from OIDC_ISSUER (back-compat). See knowledge/AUTH-PROVIDER-SPIKE.md.
AUTH_PROVIDER=

# Scopes advertised in the Protected Resource Metadata (RFC 9728) so the MCP client requests
# them at sign-in. For Adobe IMS use "openid profile email" so userinfo returns the user's email
# (used to resolve their owner identity). Space-separated; defaults to OIDC_REQUIRED_SCOPE.
OIDC_SCOPES=

# Bootstrap admin/head-chef identities (D66) - comma-separated or JSON array of owner ids
# (email/username) seeded with the admin + head-chef roles so the Team/Roles UI is reachable
# on day one. The shared x-api-key path ("service-account") is always admin implicitly.
# e.g. BOOTSTRAP_ADMINS=bharat.dudeja@tapcxm.com
BOOTSTRAP_ADMINS=

# OIDC provider (auth is pluggable - this is config, not a hardcoded dependency).
# Reference deployment uses Auth0 (D23/D24):
OIDC_ISSUER=https://your-tenant.us.auth0.com/
# Only set OIDC_DISCOVERY_URL if your provider's discovery doc isn't at the standard
# location (`${OIDC_ISSUER}.well-known/openid-configuration` if OIDC_ISSUER ends with
# "/", else `${OIDC_ISSUER}/.well-known/openid-configuration`).
OIDC_DISCOVERY_URL=

# Audience (RFC 8707) - the identifier of THIS connector's API, as registered with the
# OIDC provider (e.g. an Auth0 "API" identifier, an Entra "Application ID URI"). When
# set, tokens are verified as signed JWTs against the provider's JWKS (real, cryptographic
# audience binding - see knowledge/OAUTH-SPIKE.md / D24). When UNSET, falls back to the
# userinfo-endpoint validation path with only best-effort compensating controls (this is
# the Adobe IMS case - IMS issues no audience-bound tokens, see D19/D22).
OIDC_AUDIENCE=https://tap-mcp-connector

# To point this connector at a different OIDC provider instead of Auth0 (e.g. AWS Cognito,
# Microsoft Entra ID, Adobe IMS, Okta) - change ONLY these values, no code changes needed:
#   OIDC_ISSUER=https://ims-na1.adobelogin.com                  (Adobe IMS example - leave OIDC_AUDIENCE blank)
#   OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0 (Entra ID example)
#   OIDC_ISSUER=https://cognito-idp.<region>.amazonaws.com/<pool-id>  (Cognito example)
# A provider used with OIDC_AUDIENCE set must expose a standard OIDC discovery document
# with a `jwks_uri`; without OIDC_AUDIENCE, it must expose a `userinfo_endpoint` instead.

# OAuth client registered with the OIDC provider above (a "Regular Web App" / confidential
# user-login credential - NOT a server-to-server / machine-to-machine credential). Used for
# the defense-in-depth client-binding check in lib/auth/oidc.js (checked in addition to,
# not instead of, JWKS signature+audience verification when OIDC_AUDIENCE is set).
# Redirect URI to register with the provider:
#   https://claude.ai/api/mcp/auth_callback
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Scope required in the token (checked against the `scope` claim). With OIDC_AUDIENCE set,
# this is enforced strictly (missing/insufficient scope -> rejected). Without OIDC_AUDIENCE
# (IMS path), enforced only when the token happens to be a decodable JWT that carries a
# scope claim at all. Defaults to "openid" if unset.
OIDC_REQUIRED_SCOPE=resource.rw

# --- Dashboard per-user login (Increment 19, D65) ---
# Public SPA client id for the dashboard's OWN browser login (Authorization Code + PKCE, no
# secret). When SET, the dashboard requires each visitor to sign in with their Adobe IMS
# identity and forwards THEIR token to the MCP server, so the browser view is private to them
# (closes the shared-key open-dashboard hole). When BLANK, the dashboard stays in anonymous
# shared-key mode (backward-compatible). This value is safe to expose to the browser.
# Register this as an OAuth Single-Page App credential with redirect URI =
#   https://110557-tapmcpconnector-stage.adobeio-static.net/index.html
# See docs/ims-auth-setup.md for the full Adobe Developer Console walkthrough.
DASHBOARD_OAUTH_CLIENT_ID=

# --- Interim static-passcode lock (Increment 19, D65 stopgap) ---
# Locks the otherwise-open dashboard with a single shared access code until per-user IMS login
# is live. Enforced SERVER-SIDE in the dashboard-api proxy (the SPA only collects it), so it's
# a real gate, not a bypassable browser check. Weak by design (a shared code) - a stopgap, not
# real auth; leave blank to disable. Value lives only in .env, never committed.
DASHBOARD_PASSCODE=

# Optional API key for headless agents / local curl testing (x-api-key header).
# With per-user dashboard login enabled, this is used ONLY by headless agents hitting the MCP
# server directly - never by the dashboard browser path.
SERVICE_API_KEY=

# --- Multi-key -> owner mapping (Increment 15, D55) ---
# The quick self-serve path to giving a second user their own owner identity without a
# full OAuth login: a JSON object mapping additional x-api-key values to an owner label.
# The default SERVICE_API_KEY above always maps to "service-account" regardless of this
# map. NEVER commit real key values here - this file is the template; put actual keys
# only in your local .env. Example:
#   API_KEY_OWNERS={"tap_bob_9f2a1c...":"bob@example.com","tap_carol_7e0b2d...":"carol@example.com"}
API_KEY_OWNERS=

# --- URL overrides ---
# By default the MCP resource URL and PRM URL are derived from the request's Host header
# plus the Adobe I/O Runtime URL shape (/api/v1/web/<package>/<action>).
# REQUIRED on Adobe I/O Runtime specifically: the Host header the action sees internally
# is an infra/routing hostname (e.g. "controller-ns-team-<...>-runtime-prod-b"), not the
# public *.adobeioruntime.net domain the client used - so set these explicitly, e.g.:
#   MCP_RESOURCE_URL=https://<namespace>.adobeioruntime.net/api/v1/web/tap-mcp-connector/mcp-server
#   MCP_PRM_URL=https://<namespace>.adobeioruntime.net/api/v1/web/tap-mcp-connector/well-known
#   MCP_OAUTH_BRIDGE_URL=https://<namespace>.adobeioruntime.net/api/v1/web/tap-mcp-connector/oauth-bridge
# A different host (e.g. plain Express behind a normal reverse proxy that preserves the
# Host/X-Forwarded-Host header) may be able to leave these blank and rely on derivation.
MCP_RESOURCE_URL=
MCP_PRM_URL=
# Login bridge base URL (Increment 20, D68) - see lib/auth/oauthBridge.js. Register
# "<this>/callback" as an additional redirect URI on the provider's user-auth credential.
MCP_OAUTH_BRIDGE_URL=
MCP_PACKAGE_NAME=
